ENVIRONMENT=development
POSTGRES_DB=nba_injuries
POSTGRES_USER=nba
POSTGRES_PASSWORD=nba
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://nba:nba@localhost:5432/nba_injuries
SCRAPER_USER_AGENT=nba-injury-database/0.1 (low-frequency research client)
SCRAPER_TIMEOUT_SECONDS=30
SCRAPER_REQUEST_INTERVAL_SECONDS=2
SCRAPER_MAX_RETRIES=3
SCRAPER_BACKOFF_BASE_SECONDS=1
SCRAPER_MAX_PAGES=2000
NBA_PDF_USER_AGENT=nba-injury-database/0.1 (official NBA PDF research client)
NBA_PDF_TIMEOUT_SECONDS=30
NBA_PDF_REQUEST_INTERVAL_SECONDS=1.0
NBA_PDF_MAX_RETRIES=3
NBA_PDF_BACKOFF_BASE_SECONDS=1
